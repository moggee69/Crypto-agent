# Caddy config for the private Trading Desk PWA (install to /etc/caddy/Caddyfile).
#
# Two access tiers, both cookie-gated:
#   - FULL  (desk_auth): the owner — full access incl. the freeze controls. Set by
#     /api/login after bot_control.py verifies the password.
#   - VIEW  (desk_view): read-only share-link visitors. Set by /api/enter?v=<token>.
#     They can view the page + /api/status; all admin/write endpoints are blocked.
# Unauthenticated requests redirect to /login.html. Public: login page + endpoint,
# the read-only /api/enter, and the PWA install assets.
#
# Paste the two tokens below (from remember_token.txt and view_token.txt), then
# reload:  systemctl reload caddy

165-227-84-219.sslip.io {
	root * /opt/crypto-agent/webapp
	encode gzip

	# admin (full) actions require the full-access cookie — read-only visitors get 403
	@adminonly {
		path /api/halt/* /api/resume/* /api/sharelink
		not header Cookie *desk_auth=REPLACE_WITH_TOKEN*
	}
	respond @adminonly 403

	# no full AND no read-only cookie, and not a public path -> send to the login page
	@needlogin {
		not header Cookie *desk_auth=REPLACE_WITH_TOKEN*
		not header Cookie *desk_view=REPLACE_WITH_VIEW_TOKEN*
		not path /login.html /api/login /api/enter /manifest.json /icon-180.png /icon-192.png /icon-512.png
	}
	redir @needlogin /login.html 302

	reverse_proxy /api/* localhost:8899
	file_server
}
